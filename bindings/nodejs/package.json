{
  "name": "nervusdb-node",
  "version": "0.1.0",
  "description": "Node.js and TypeScript bindings for NervusDB, an embedded single-file property graph database",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "nervusdb",
    "triples": {
      "default": true
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node test.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  },
  "keywords": [
    "graph",
    "database",
    "sqlite",
    "cypher",
    "embedded",
    "napi"
  ],
  "license": "AGPL-3.0-only"
}
